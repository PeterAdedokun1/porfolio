# Resend API key — powers the contact form (/api/contact).
# 1. Create a free account at https://resend.com
# 2. Go to "API Keys" and create one.
# 3. Copy it into .env.local (which is gitignored) as:
#    RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The form works immediately using Resend's onboarding@resend.dev sender.
# To send from your own domain, verify it in Resend and update FROM_EMAIL
# in app/api/contact/route.ts.
RESEND_API_KEY=
